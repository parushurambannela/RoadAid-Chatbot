# MongoDB
MONGODB_URL="mongodb://localhost:27017/roadaid"
DATABASE_NAME="roadaid"

# Google Gemini
GOOGLE_API_KEY="your api key"
GEMINI_MODEL="gemini-2.5-pro"

# Embeddings model for RAG
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# ChromaDB (for RAG)
CHROMA_PERSIST_DIR=./chroma_db

# App settings
APP_ENV=development
LOG_LEVEL=debug

# JWT auth
JWT_SECRET_KEY="roadaid-super-secret-key-change-in-production"
JWT_EXPIRE_HOURS=24
